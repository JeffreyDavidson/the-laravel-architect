#!/usr/bin/env bash
set -euo pipefail

# Fast local guard only. Full static analysis, Rector, Pest, and browser tests
# belong in CI or explicit verification commands such as composer test:parallel.

staged_php_files=()
while IFS= read -r -d '' file; do
    if [[ "$file" == *.php && -f "$file" ]]; then
        staged_php_files+=("$file")
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [[ ${#staged_php_files[@]} -eq 0 ]]; then
    exit 0
fi

echo "Running fast pre-commit checks..."

for file in "${staged_php_files[@]}"; do
    if ! output=$(php -l "$file" 2>&1); then
        echo "PHP syntax error in $file:"
        echo "$output"
        exit 1
    fi
done

echo "PHP lint passed"

if [[ -x vendor/bin/pint ]] && ! vendor/bin/pint --blade --test --format=txt "${staged_php_files[@]}"; then
    echo "Commit blocked: Pint found formatting issues."
    echo "Run 'composer lint' to fix them."
    exit 1
fi

echo "Pint passed"
