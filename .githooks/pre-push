#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_PRE_PUSH_CHECKS:-0}" == "1" ]]; then
    echo "Skipping pre-push checks (SKIP_PRE_PUSH_CHECKS=1)."
    exit 0
fi

refs=$(cat)

if [[ -n "$refs" ]] && ! grep -Evq '^[^ ]+ 0+ ' <<< "$refs"; then
    echo "pre-push: only deleting refs; skipping checks."
    exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "$local_sha" || "$local_sha" =~ ^0+$ ]] && continue
    if [[ "$remote_sha" == 0000000000000000000000000000000000000000 ]]; then
        commits=$(git rev-list "$local_sha" --not --remotes=origin)
        if [[ -n "$commits" ]]; then
            files=$(while read -r commit; do
                git diff-tree --root --no-commit-id --name-only -r "$commit" -- '*.php'
            done <<< "$commits" | sort -u)
        else
            files=''
        fi
    else
        files=$(git diff-tree --no-commit-id --name-only -r "$remote_sha..$local_sha" -- '*.php' || true)
    fi
    if [[ -n "$files" ]]; then
        changed_files=()
        while IFS= read -r file; do
            changed_files+=("$file")
        done <<< "$files"
        php scripts/check-method-chaining.php "${changed_files[@]}"
    fi
done <<< "$refs"

echo "Running project pre-push checks..."
npm run test:deployment
composer test
composer test:browser
composer test:types
composer test:types:pest
composer test:rector
composer test:rector:pest
