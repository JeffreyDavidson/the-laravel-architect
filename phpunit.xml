<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Architecture">
            <directory suffix="Test.php">tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory suffix="Test.php">tests/Integration</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory suffix="Test.php">tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">app</directory>
        </include>
    </source>
    <php>
        <!-- Laravel also reads inherited server variables; env overrides alone do not replace them. -->
        <server name="APP_ENV" value="testing"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="RESEND_API_KEY" value=""/>
        <server name="TURNSTILE_SITE_KEY" value=""/>
        <server name="TURNSTILE_SECRET_KEY" value=""/>
        <server name="SENTRY_DSN" value=""/>
        <server name="SENTRY_LARAVEL_DSN" value=""/>
        <server name="SENTRY_SEND_DEFAULT_PII" value="false"/>
        <server name="NIGHTWATCH_TOKEN" value=""/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="YOUTUBE_API_KEY" value=""/>
        <server name="BACKUP_ARCHIVE_PASSWORD" value=""/>
        <server name="BACKUP_B2_KEY_ID" value=""/>
        <server name="BACKUP_B2_APPLICATION_KEY" value=""/>
        <server name="AWS_ACCESS_KEY_ID" value=""/>
        <server name="AWS_SECRET_ACCESS_KEY" value=""/>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="RESEND_API_KEY" value="" force="true"/>
        <env name="TURNSTILE_SITE_KEY" value="" force="true"/>
        <env name="TURNSTILE_SECRET_KEY" value="" force="true"/>
        <env name="SENTRY_DSN" value="" force="true"/>
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
        <env name="SENTRY_SEND_DEFAULT_PII" value="(false)" force="true"/>
        <env name="NIGHTWATCH_TOKEN" value="" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="(false)" force="true"/>
        <env name="TELESCOPE_ENABLED" value="(false)" force="true"/>
        <env name="YOUTUBE_API_KEY" value="" force="true"/>
        <env name="BACKUP_ARCHIVE_PASSWORD" value="" force="true"/>
        <env name="BACKUP_B2_KEY_ID" value="" force="true"/>
        <env name="BACKUP_B2_APPLICATION_KEY" value="" force="true"/>
        <env name="AWS_ACCESS_KEY_ID" value="" force="true"/>
        <env name="AWS_SECRET_ACCESS_KEY" value="" force="true"/>
    </php>
</phpunit>
