APP_NAME="The Laravel Architect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: set APP_ENV=production, APP_DEBUG=false, and use the canonical HTTPS URL.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ADMIN_EMAIL=admin@example.test
CONTENT_AUTHOR_EMAIL=author@example.test

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Production SQLite: set DB_DATABASE to the absolute path of the persistent live database.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Production: set SESSION_SECURE_COOKIE=true.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
RUNTIME_HEALTH_ENABLED=false
RUNTIME_HEALTH_MAX_AGE=300
# Production: set RUNTIME_HEALTH_ENABLED=true.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="hello@thelaravelarchitect.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=
MAIL_CONTACT_TO=admin@example.test

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production backups
# BACKUP_MEDIA_PATH=/absolute/path/to/shared/storage/app/public
# BACKUP_MEDIA_PATH must point to the persistent public-media directory in production.
BACKUP_DISKS=local
BACKUP_NOTIFICATION_EMAIL="${MAIL_CONTACT_TO}"
# BACKUP_ARCHIVE_PASSWORD=
# Production: include an off-server disk in BACKUP_DISKS and set BACKUP_ARCHIVE_PASSWORD.
BACKUP_RUN_AT=02:00
BACKUP_CLEAN_AT=03:00
BACKUP_MONITOR_AT=04:00

VITE_APP_NAME="${APP_NAME}"

YOUTUBE_API_KEY=
FATHOM_SITE_ID=
YOUTUBE_CHANNEL_ID=UC42H30o7l5QvvCzC86dSu_A
