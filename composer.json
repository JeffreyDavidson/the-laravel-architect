{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jeffreydavidson/the-laravel-architect",
    "type": "project",
    "description": "Personal website, blog, portfolio, podcast archive, and newsletter for The Laravel Architect.",
    "keywords": [
        "laravel",
        "filament",
        "blog"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.7",
        "filament/spatie-laravel-tags-plugin": "^5.0",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.26",
        "laravel/nightwatch": "^1.30",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.30",
        "league/flysystem-sftp-v3": "^3.0",
        "ralphjsmit/laravel-filament-seo": "^2.2",
        "ralphjsmit/laravel-seo": "^1.8",
        "resend/resend-laravel": "^1.3",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.2",
        "spatie/laravel-tags": "^4.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "jasonmccreary/double": "^0.6.1",
        "larastan/larastan": "^3.8",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "laraveldaily/filacheck": "^1.1",
        "laraveldaily/filacheck-pro": "^1.1",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0.1",
        "pestphp/pest-plugin-livewire": "^5.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest"
        ],
        "test:filament": "vendor/bin/filacheck --detailed",
        "test:types": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress --error-format=table",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "name": "filacheck",
            "type": "composer",
            "url": "https://satis.filamentexamples.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
