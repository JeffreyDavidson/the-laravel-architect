{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jeffreydavidson/the-laravel-architect",
    "type": "project",
    "description": "Personal website, blog, portfolio, podcast archive, and newsletter for The Laravel Architect.",
    "keywords": [
        "laravel",
        "filament",
        "blog"
    ],
    "license": "MIT",
    "require": {
        "filament/filament": "^5.7",
        "filament/spatie-laravel-tags-plugin": "^5.0",
        "intervention/image": "^4.0",
        "laravel/framework": "^13.26",
        "laravel/nightwatch": "^1.30",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.30",
        "league/flysystem-sftp-v3": "^3.0",
        "livewire/livewire": "^4.4",
        "nunomaduro/laravel-sluggable": "^1.0",
        "php": "^8.5",
        "ralphjsmit/laravel-filament-seo": "^2.2",
        "ralphjsmit/laravel-seo": "^1.8",
        "resend/resend-laravel": "^1.3",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.2",
        "spatie/laravel-tags": "^4.11"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "christophrumpel/missing-livewire-assertions": "^4.0",
        "driftingly/rector-laravel": "^2.6",
        "jasonmccreary/double": "^0.7.0",
        "larastan/larastan": "^3.8",
        "laravel/boost": "^2.0",
        "laravel/doctor": "^0.1.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.27",
        "laraveldaily/filacheck": "^1.1",
        "laraveldaily/filacheck-pro": "^1.1",
        "mockery/mockery": "^1.6",
        "mrpunyapal/laravel-auditor": "^0.1.6",
        "newdebugbar/newdebugbar": "dev-main",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0.1",
        "pestphp/pest-plugin-faker": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-mutate": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.6",
        "spatie/pest-plugin-snapshots": "^2.2",
        "spatie/pest-plugin-test-time": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#c4b5fd,#fb7185,#fdba74\" \"php artisan queue:listen database --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest"
        ],
        "lint": "vendor/bin/pint --blade",
        "lint:check": "vendor/bin/pint --blade --test",
        "test:parallel": [
            "vendor/bin/pest --parallel --exclude-testsuite Browser",
            "vendor/bin/pest --testsuite Browser"
        ],
        "test:filament": "vendor/bin/filacheck --detailed",
        "test:rector": "PAO_DISABLE=1 vendor/bin/rector process --dry-run --no-progress-bar",
        "test:rector:pest": "PAO_DISABLE=1 vendor/bin/rector process --config=rector-pest.php --dry-run --no-progress-bar",
        "test:types": "PAO_DISABLE=1 vendor/bin/phpstan analyse --memory-limit=1G --no-progress --error-format=table",
        "test:types:pest": "PAO_DISABLE=1 APP_ENV=testing vendor/bin/phpstan analyse --configuration=phpstan-pest.neon --memory-limit=1G --no-progress --error-format=table",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "name": "filacheck",
            "type": "composer",
            "url": "https://satis.filamentexamples.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
